# Copia este archivo como .env (no se sube a git) y completa los valores.
# En Render, estas mismas variables van en Environment.

# supabase: guarda en Supabase. memory: en el proceso, para desarrollar sin base
STORAGE=supabase

# Supabase → Project Settings → API Keys / Data API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# La clave secreta (sb_secret_…) o la antigua service_role. Salta el RLS:
# nunca la pongas en la app ni en la web
SUPABASE_SECRET_KEY=

# Token que la app manda en POST /api/eventos (EXPO_PUBLIC_API_TOKEN en
# app-movil/.env). Queda dentro de la app, así que sólo permite escribir eventos.
# Vacío, la ruta queda abierta. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN_APP=

# Token de /api/admin: leer los datos sin agregar y corregir semáforos y
# reportes. Tiene que ser distinto del de la app. Vacío, /api/admin no responde
API_TOKEN_ADMIN=

# Orígenes del navegador que pueden llamar a la API, separados por comas
CORS_ORIGINS=https://snt8.github.io,http://localhost:5173

# Opcionales (estos son los valores por defecto)
# MAX_EVENTS_PER_BATCH=500
# MAX_BODY_BYTES=1000000
# TELEMETRY_RANGE_DAYS=30
# REPORTS_PER_HOUR_PER_CLIENT=10

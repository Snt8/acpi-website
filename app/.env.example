# Copia este archivo como .env.local y completa los valores.
# El mapa (OpenStreetMap) no necesita configuración.

# Grafana: solo los usa `pnpm telemetry` (y la Action en CI).
# Nunca lleves estas variables al navegador con el prefijo VITE_.
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_QUERIES=
GRAFANA_RANGE_DAYS=30

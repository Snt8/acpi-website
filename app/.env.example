# Copia este archivo como .env.local y completa los valores.

# Google Maps (mapa de semáforos reportados). Sin clave, la página funciona
# igual y muestra un aviso en lugar del mapa.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID propio; sin él se usa DEMO_MAP_ID, válido solo para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=

# Grafana: solo los usa `pnpm telemetry` (y la Action en CI).
# Nunca lleves estas variables al navegador con el prefijo VITE_.
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_QUERIES=
GRAFANA_RANGE_DAYS=30
